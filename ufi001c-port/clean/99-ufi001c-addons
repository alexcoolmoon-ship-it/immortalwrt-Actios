#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
[ "$(cat /tmp/sysinfo/board_name)" = 'thwc,ufi001c' ] || exit 0
# Upstream Podkop configuration: no global DNS detour or custom recovery loop.
# Keep ordinary LTE DNS until the owner supplies their own proxy URL.
uci -q batch <<'EOF'
set sing-box.main.dns_fallback='0'
set sing-box.main.failsafe='0'
set firewall.@defaults[0].flow_offloading='0'
set firewall.@defaults[0].flow_offloading_hw='0'
commit sing-box
commit firewall
EOF
/etc/init.d/podkop disable
/etc/init.d/sing-box disable
exit 0

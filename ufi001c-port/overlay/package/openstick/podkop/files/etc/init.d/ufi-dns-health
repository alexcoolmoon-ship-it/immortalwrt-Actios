#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
start_service() {
    [ "$(uci -q get podkop.settings.ufi_dns_health)" != 0 ] || return 0
    procd_open_instance
    procd_set_param command /usr/lib/podkop/ufi_dns_health.sh watch
    procd_set_param respawn 3600 10 3
    procd_set_param stderr 1
    procd_close_instance
}
service_triggers() { procd_add_reload_trigger podkop; }

#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=98
STOP=10
USE_PROCD=1
start_service() {
    # Capture DNS/firewall baseline before START=99 (Podkop) changes it.
    local n=0
    until /usr/sbin/ufi-care snapshot >/dev/null 2>&1; do
        n=$((n + 1))
        [ "$n" -lt 12 ] || break
        sleep 5
    done
    procd_open_instance guard
    procd_set_param command /usr/sbin/ufi-care guard
    procd_set_param respawn 3600 10 3
    procd_close_instance
    procd_open_instance button
    procd_set_param command /usr/sbin/ufi-care button
    procd_set_param respawn 3600 10 3
    procd_close_instance
}

CONFIG_TARGET_msm89xx=y
CONFIG_TARGET_msm89xx_msm8916=y
CONFIG_TARGET_msm89xx_msm8916_DEVICE_openstick-ufi001c=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_TARGET_EXT4_RESERVED_PCT=0
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-ru=y
CONFIG_PACKAGE_luci-i18n-firewall-ru=y
CONFIG_PACKAGE_luci-i18n-package-manager-ru=y
CONFIG_LUCI_LANG_ru=y
CONFIG_PACKAGE_luci-proto-modemmanager=y
CONFIG_PACKAGE_modemmanager=y
CONFIG_MODEMMANAGER_WITH_NETIFD=y
CONFIG_MODEMMANAGER_WITH_QMI=y
CONFIG_MODEMMANAGER_WITH_QRTR=y
# CONFIG_MODEMMANAGER_WITH_MBIM is not set
CONFIG_PACKAGE_libqmi-utils=y
CONFIG_LIBQMI_WITH_QRTR_GLIB=y
CONFIG_PACKAGE_qrtr-ns=y
CONFIG_PACKAGE_rmtfs=y
CONFIG_PACKAGE_gc=y
CONFIG_PACKAGE_ufi001c-defaults=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
# CONFIG_ALL_KMODS is not set
# CONFIG_ALL is not set
# CONFIG_IB is not set
# CONFIG_SDK is not set
# CONFIG_COLLECT_KERNEL_DEBUG is not set
CONFIG_CCACHE=y
# CONFIG_GDB is not set
# CONFIG_KERNEL_DEBUG_INFO is not set
